{
  "name": "meeting-and-study-room-hub",
  "private": true,
  "version": "1.0.0",
  "description": "Meeting and Study Room Hub Desktop Application",
  "author": "Abrar <abrar@example.com>",
  "homepage": "https://github.com/example/meeting-and-study-room-hub",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "electron .",
    "electron:build": "electron-builder",
    "electron:build:all": "electron-builder --linux deb --win nsis",
    "build:electron": "npm install && npm run build && electron-builder --linux deb --win nsis && cp dist-electron/*.deb dist-electron/*.exe ../ 2>/dev/null || true",
    "dev:electron": "npm run dev & wait-on http://localhost:3000 && electron ."
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.meeting.studyroomhub",
    "productName": "MeetingAndStudyRoomHub",
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "preload.js",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Education"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "output": "dist-electron"
    }
  }
}
